# Process reads OS environment variables (this file is documentation only).
# Copy values into your shell, systemd unit, or a local .env loader — do not commit real secrets.

# desktop = Windows WebView2 window (no login); server = HTTP only (login required)
# HELLO_CODER_MODE=server
# --mode desktop|server also works

# Override login gate: on = require auth, off = skip (default follows mode)
# HELLO_CODER_AUTH=on

# desktop default 127.0.0.1:10240; server default :10240
# HELLO_CODER_ADDR=:10240

HELLO_CODER_DATA_DIR=./data
HELLO_CODER_LOG_LEVEL=info

# Dev: point at web/static so frontend edits apply without rebuild. Production: leave empty (embed).
HELLO_CODER_STATIC_DIR=./web/static

# Production: set both. Local defaults exist for development only.
HELLO_CODER_JWT_SECRET=change-me
HELLO_CODER_JWT_TTL_HOURS=4
HELLO_CODER_DATA_KEY=change-me
